  m_Name: 
  m_EditorClassIdentifier: Unity.TextMeshPro::TMPro.TextMeshProUGUI
  m_Material: {fileID: 0}
  m_Color: {r: 1, g: 1, b: 1, a: 1}
  m_RaycastTarget: 1
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "RULES\n\u2022 The game ends at the End of Day once a player completes
    their 4th Prank\n\u2022 Highest final score wins\n\nFINAL SCORE\n\u2022 Prank
    Points + Influence\n\u2022 Influence is based on the modifier shown on the final
    completed prank\n\nTURN OPTIONS\n\u2022 Scout \u2014 Draw from the recruit deck,
    then dismiss a recruit\n\u2022 Recruit \u2014 Take the top recruit from the discard
    pile (if available), then dismiss a recruit\n\u2022 Refer a Recruit \u2014 Place
    a recruit into circulation to gain Influence\n  (Influence gained equals the
    recruit\u2019s matching prank icons)\n  Max 3 referred recruits per round\n\u2022
    Swap \u2014 Exchange a recruit from your hand with one in an opponent\u2019s
    circulation area\n\u2022 Complete Prank \u2014 Complete a prank using 4 matching
    recruits to gain Prank Points\n\nRECRUITS SPECIALIZE THROUGH THE FOLLOWING ACTIONS:\n(See
    the Statistics screen from the Main Menu)\n\u2022Gain Influence with a recruit
    type\n15 / 50 / 100 Assistant / Strategist / Advisor\n\u2022Dismiss recruits
    of a specific type\n20 / 50 / 90 Hustler / Opportunist / Manipulator\n\u2022Complete
    pranks using 4 identical recruits\n1 / 5 / 10 Crew Leader / Expert / Master"
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
